{
  "name": "stokhastik",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docker": "docker-compose --env-file /dev/null up -d",
    "migrate": "npx prisma migrate deploy",
    "generate": "npx prisma generate",
    "stripe": "stripe listen --events payment_intent.succeeded,payment_intent.payment_failed,charge.refunded --forward-to localhost:3000/api/stripe/webhook",
    "dev": "concurrently \"yarn docker\" \"next dev\" \"yarn stripe\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "omikuji:index": "node --env-file-if-exists=.env tools/scripts/omikuji/index.mjs",
    "omikuji": "node --env-file-if-exists=.env tools/scripts/omikuji/ask.mjs",
    "search": "node --env-file-if-exists=.env tools/scripts/omikuji/search.mjs",
    "source": "node --env-file-if-exists=.env tools/scripts/source/source.mjs",
    "seed:scans": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env tools/scripts/seed-scans.mjs"
  },
  "dependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "@base-ui/react": "1.9.0",
    "@markdoc/markdoc": "0.5.11",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "9.8.2",
    "@stripe/react-stripe-js": "7.0.1",
    "@stripe/stripe-js": "10.2.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "9.3.1",
    "@types/three": "0.187.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "motion": "14.9.0",
    "next": "16.4.3",
    "next-auth": "^4.24.15",
    "nodemailer": "10.3.1",
    "nuqs": "2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.5",
    "stripe": "23.1.0",
    "three": "0.187.0",
    "use-scramble": "^2.2.15",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "10.0.6",
    "dotenv": "18.0.9",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "sharp": "0.35.5"
  }
}
